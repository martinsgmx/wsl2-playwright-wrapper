# Copy to .secrets.env and fill — never commit .secrets.env
# Playwright MCP loads this via --secrets (dotenv). See docs/configuration.md and docs/auth.md

# Where to log in (full URL). init-auth.ts only acts when current page matches this pathname.
AUTH_URL=http://localhost:3000/login

# Credentials injected into the login form
AUTH_USERNAME=test@example.com
AUTH_PASSWORD=test123

# Success redirect — glob matched via page.waitForURL(). Examples:
#   **/dashboard**   → any URL containing /dashboard
#   **/app/**        → any URL under /app/
#   http://localhost:3000/dashboard
AUTH_SUCCESS_PATH=**/dashboard**

# Optional selector overrides if your app doesn't use standard inputs
# AUTH_USER_SELECTOR=input[name="username"]
# AUTH_PASS_SELECTOR=input[name="password"]
# AUTH_SUBMIT_SELECTOR=button[type="submit"]

# CDP port (Windows Brave --remote-debugging-port)
CDP_PORT=9222

# Optional: change CDP host manually (normally auto-detected)
# CDP_HOST=localhost
